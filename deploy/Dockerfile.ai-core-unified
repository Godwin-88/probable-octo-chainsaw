# One Python gateway: ai-core (gRPC) + TRANSACT FastAPI (REST on 8000)
FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.cargo/bin:${PATH}"

# Install maturin for building Rust extensions
RUN pip install --no-cache-dir maturin

# ---- ai-core requirements ----
COPY ai-core/requirements.txt ./ai-core-requirements.txt
RUN pip install --no-cache-dir -r ai-core-requirements.txt

# ---- TRANSACT requirements ----
COPY psychic-invention/requirements.txt ./psychic-invention/requirements.txt
RUN pip install --no-cache-dir -r psychic-invention/requirements.txt

# ---- Build pricing_engine (Rust) ----
COPY psychic-invention/ /app/psychic-invention/
WORKDIR /app/psychic-invention
RUN maturin build --release --out dist && \
    pip install dist/*.whl

# ---- Final Stage ----
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy source code
COPY proto/ /app/proto/
COPY ai-core/ /app/ai-core/
COPY psychic-invention/ /app/psychic-invention/
COPY deploy/start_ai_core_unified.sh /app/start_ai_core_unified.sh

# Generate gRPC code
WORKDIR /app/ai-core
RUN python -m grpc_tools.protoc -I/app/proto --python_out=./ai_core --grpc_python_out=./ai_core /app/proto/optimize.proto

WORKDIR /app
RUN chmod +x /app/start_ai_core_unified.sh

ENV PYTHONPATH="/app/ai-core:/app/psychic-invention"
ENV TRANSACT_API_URL=http://127.0.0.1:8000
ENV NEO4J_PASSWORD=yield-agent-dev

EXPOSE 50051 8000
ENTRYPOINT ["/app/start_ai_core_unified.sh"]

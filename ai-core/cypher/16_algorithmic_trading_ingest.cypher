MERGE (f:Formula {id: 'aat-ebook-20170711_copy:12:f185'})
SET f.text = 'yt = F T', f.meaning = 'Where F T is the transpose of F.', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';

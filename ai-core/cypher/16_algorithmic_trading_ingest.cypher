SET f.text = 'would indicate (with α = β = 0) that the process is a random walk and thus non mean reverting.', f.meaning = 'Hence we are testing for the null hypothesis that γ = 0.', f.sourceId = 'successful_algorithmic_trading', f.sectionId = 'successful_algorithmic_trading:11';

SET f.text = 'σ = 12.4%. In addition suppose we are able to borrow at a risk-free interest rate of r = 3.0%.', f.meaning = 'Sharpe Ratio of S = 0.077/0.124 = 0.62.', f.sourceId = 'successful_algorithmic_trading', f.sectionId = 'successful_algorithmic_trading:12';

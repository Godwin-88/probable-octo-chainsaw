SET f.text = 'stock XYZ that has a mean annual return of m = 10.7% and an annual standard deviation of', f.meaning = 'σ = 12.4%. In addition suppose we are able to borrow at a risk-free interest rate of r = 3.0%.', f.sourceId = 'successful_algorithmic_trading', f.sectionId = 'successful_algorithmic_trading:12';
MATCH (sec:Section {id: 'successful_algorithmic_trading:12'}), (f:Formula {id: 'successful_algorithmic_trading:12:f40'})

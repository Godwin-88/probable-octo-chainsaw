MERGE (sec)-[:HAS_FORMULA]->(f);

MERGE (f:Formula {id: 'aat-ebook-20170711_copy:12:f186'})
SET f.text = 'quantity Dt. Oour current observations are denoted by yt. Thus we can say that Dt = (Dt−1, yt).', f.meaning = 'Our current knowledge is a mixture of our previous knowledge plus our most recent observation.', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';
MATCH (sec:Section {id: 'aat-ebook-20170711_copy:12'}), (f:Formula {id: 'aat-ebook-20170711_copy:12:f186'})
MERGE (sec)-[:HAS_FORMULA]->(f);

MERGE (f:Formula {id: 'aat-ebook-20170711_copy:12:f187'})
SET f.text = 'The Kalman Filter is what links all of these terms together for t = 1, . . . , n. We we will not', f.meaning = '', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';
MATCH (sec:Section {id: 'aat-ebook-20170711_copy:12'}), (f:Formula {id: 'aat-ebook-20170711_copy:12:f187'})
MERGE (sec)-[:HAS_FORMULA]->(f);

MERGE (f:Formula {id: 'aat-ebook-20170711_copy:12:f188'})
SET f.text = 'where we make this prediction at time t −1. Since et = yt −ft, we can see easily that et is the', f.meaning = 'error associated with the forecast–the diﬀerence between f and y.', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';
MATCH (sec:Section {id: 'aat-ebook-20170711_copy:12'}), (f:Formula {id: 'aat-ebook-20170711_copy:12:f188'})
MERGE (sec)-[:HAS_FORMULA]->(f);

MERGE (f:Formula {id: 'aat-ebook-20170711_copy:12:f189'})
SET f.text = 'mt = at + Atet = Gtmt−1 + Atet, where Gt and At are our weighting matrices.', f.meaning = 'states we can use it to make predictions as well as smooth the data.', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';
MATCH (sec:Section {id: 'aat-ebook-20170711_copy:12'}), (f:Formula {id: 'aat-ebook-20170711_copy:12:f189'})
MERGE (sec)-[:HAS_FORMULA]->(f);

MERGE (f:Formula {id: 'aat-ebook-20170711_copy:12:f190'})
SET f.text = 'Where βT = (β0, β1, . . . , βp) represents the transpose vector of the intercept β0 and slopes βi,', f.meaning = 'with ϵ ∼N(µ, σ2) represents the error term.', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';
MATCH (sec:Section {id: 'aat-ebook-20170711_copy:12'}), (f:Formula {id: 'aat-ebook-20170711_copy:12:f190'})

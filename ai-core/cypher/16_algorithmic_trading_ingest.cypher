SET f.text = 'It is estimated by the Kalman ﬁlter. The forecast error/residual et = yt −ˆyt is the diﬀerence', f.meaning = 'of the predictions and hence √Qt is the standard deviation of the prediction.', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';

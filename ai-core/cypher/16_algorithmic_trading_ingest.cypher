MERGE (f:Formula {id: 'aat-ebook-20170711_copy:12:f128'})
SET f.text = 'xt = µ + A1xt−1 + . . . + Apxt−p + wt', f.meaning = 'and wt is a multivariate Gaussian noise term with mean zero.', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';
MATCH (sec:Section {id: 'aat-ebook-20170711_copy:12'}), (f:Formula {id: 'aat-ebook-20170711_copy:12:f128'})
MERGE (sec)-[:HAS_FORMULA]->(f);

MERGE (f:Formula {id: 'aat-ebook-20170711_copy:12:f129'})
SET f.text = 'The test checks for the situation of no cointegration, which occurs when the matrix A = 0.', f.meaning = 'and can check for multiple linear combinations of time series for forming stationary portfolios.', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';
MATCH (sec:Section {id: 'aat-ebook-20170711_copy:12'}), (f:Formula {id: 'aat-ebook-20170711_copy:12:f129'})
MERGE (sec)-[:HAS_FORMULA]->(f);

MERGE (f:Formula {id: 'aat-ebook-20170711_copy:12:f130'})
SET f.text = 'one, through to r = n −1, where n is the number of time series under test.', f.meaning = 'a cointegrating relationship between two or possibly more time series.', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';
MATCH (sec:Section {id: 'aat-ebook-20170711_copy:12'}), (f:Formula {id: 'aat-ebook-20170711_copy:12:f130'})
MERGE (sec)-[:HAS_FORMULA]->(f);

MERGE (f:Formula {id: 'aat-ebook-20170711_copy:12:f131'})
SET f.text = 'The null hypothesis of r = 0 means that there is no cointegration at all. A rank r > 0 implies', f.meaning = 'a cointegrating relationship between two or possibly more time series.', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';
MATCH (sec:Section {id: 'aat-ebook-20170711_copy:12'}), (f:Formula {id: 'aat-ebook-20170711_copy:12:f131'})
MERGE (sec)-[:HAS_FORMULA]->(f);

MERGE (f:Formula {id: 'aat-ebook-20170711_copy:12:f132'})
SET f.text = 'K=2.', f.meaning = 'or spec="transitory".', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';
MATCH (sec:Section {id: 'aat-ebook-20170711_copy:12'}), (f:Formula {id: 'aat-ebook-20170711_copy:12:f132'})
MERGE (sec)-[:HAS_FORMULA]->(f);

MERGE (f:Formula {id: 'aat-ebook-20170711_copy:12:f133'})
SET f.text = 'ecdet refers to whether to use a constant or drift term in the model, while spec="longrun"', f.meaning = 'or spec="transitory".', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';
MATCH (sec:Section {id: 'aat-ebook-20170711_copy:12'}), (f:Formula {id: 'aat-ebook-20170711_copy:12:f133'})
MERGE (sec)-[:HAS_FORMULA]->(f);

MERGE (f:Formula {id: 'aat-ebook-20170711_copy:12:f134'})
SET f.text = 'refers to the speciﬁcation of the VECM discussed above. This parameter can be spec="longrun"', f.meaning = 'or spec="transitory".', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';
MATCH (sec:Section {id: 'aat-ebook-20170711_copy:12'}), (f:Formula {id: 'aat-ebook-20170711_copy:12:f134'})
MERGE (sec)-[:HAS_FORMULA]->(f);

MERGE (f:Formula {id: 'aat-ebook-20170711_copy:12:f135'})
SET f.text = 'or spec="transitory".', f.meaning = '', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';
MATCH (sec:Section {id: 'aat-ebook-20170711_copy:12'}), (f:Formula {id: 'aat-ebook-20170711_copy:12:f135'})
MERGE (sec)-[:HAS_FORMULA]->(f);

MERGE (f:Formula {id: 'aat-ebook-20170711_copy:12:f136'})
SET f.text = '> jotest=ca.jo(data.frame(p,q,r), type="trace", K=2, ecdet="none",', f.meaning = '', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';
MATCH (sec:Section {id: 'aat-ebook-20170711_copy:12'}), (f:Formula {id: 'aat-ebook-20170711_copy:12:f136'})
MERGE (sec)-[:HAS_FORMULA]->(f);

MERGE (f:Formula {id: 'aat-ebook-20170711_copy:12:f137'})
SET f.text = 'spec="longrun")', f.meaning = '', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';
MATCH (sec:Section {id: 'aat-ebook-20170711_copy:12'}), (f:Formula {id: 'aat-ebook-20170711_copy:12:f137'})
MERGE (sec)-[:HAS_FORMULA]->(f);

MERGE (f:Formula {id: 'aat-ebook-20170711_copy:12:f138'})
SET f.text = 'r = 0', f.meaning = '', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';
MATCH (sec:Section {id: 'aat-ebook-20170711_copy:12'}), (f:Formula {id: 'aat-ebook-20170711_copy:12:f138'})
MERGE (sec)-[:HAS_FORMULA]->(f);

MERGE (f:Formula {id: 'aat-ebook-20170711_copy:12:f139'})
SET f.text = 'r = 0. For each of these three tests we have not only the statistic itself (given under the test', f.meaning = 'column) but also the critical values at certain levels of conﬁdence: 10%, 5% and 1% respectively.', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';
MATCH (sec:Section {id: 'aat-ebook-20170711_copy:12'}), (f:Formula {id: 'aat-ebook-20170711_copy:12:f139'})
MERGE (sec)-[:HAS_FORMULA]->(f);

MERGE (f:Formula {id: 'aat-ebook-20170711_copy:12:f140'})
SET f.text = 'The ﬁrst hypothesis, r = 0, tests for the presence of cointegration. It is clear that since the', f.meaning = '', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';
MATCH (sec:Section {id: 'aat-ebook-20170711_copy:12'}), (f:Formula {id: 'aat-ebook-20170711_copy:12:f140'})
MERGE (sec)-[:HAS_FORMULA]->(f);

MERGE (f:Formula {id: 'aat-ebook-20170711_copy:12:f141'})
SET f.text = 'Thus the best estimate of the rank of the matrix is r = 3, which tells us that we need a linear', f.meaning = 'of the series, as the underlying random walk utilised for all three series is non-stationary.', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';
MATCH (sec:Section {id: 'aat-ebook-20170711_copy:12'}), (f:Formula {id: 'aat-ebook-20170711_copy:12:f141'})
MERGE (sec)-[:HAS_FORMULA]->(f);

MERGE (f:Formula {id: 'aat-ebook-20170711_copy:12:f142'})
SET f.text = '> s = 1.000*p + 1.791324*q - 1.717271*r', f.meaning = '', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';
MATCH (sec:Section {id: 'aat-ebook-20170711_copy:12'}), (f:Formula {id: 'aat-ebook-20170711_copy:12:f142'})
MERGE (sec)-[:HAS_FORMULA]->(f);

MERGE (f:Formula {id: 'aat-ebook-20170711_copy:12:f143'})

SET f.text = 'unit root. The original test considers a time series zt = αzt−1 + wt, in which wt is discrete white', f.meaning = 'noise. The null hypothesis is that α = 1, while the alternative hypothesis is that α < 1.', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';

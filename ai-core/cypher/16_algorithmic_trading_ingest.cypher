MERGE (f:Formula {id: 'aat-ebook-20170711_copy:12:f26'})
SET f.text = 'noise. The null hypothesis is that α = 1, while the alternative hypothesis is that α < 1.', f.meaning = '', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';
MATCH (sec:Section {id: 'aat-ebook-20170711_copy:12'}), (f:Formula {id: 'aat-ebook-20170711_copy:12:f26'})

SET f.text = 'the larger two-dimensional plane, whereas for p = 3 the hyerplane is a two-dimensional plane', f.meaning = '', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';

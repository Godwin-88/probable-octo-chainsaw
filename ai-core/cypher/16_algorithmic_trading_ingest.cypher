MERGE (f:Formula {id: 'aat-ebook-20170711_copy:12:f477'})
SET f.text = 'For the case of p = 2 this hyperplane is simply a one-dimensional straight line, which lives in', f.meaning = '', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';

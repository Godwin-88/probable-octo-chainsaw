MERGE (sec)-[:HAS_FORMULA]->(f);

MERGE (f:Formula {id: 'aat-ebook-20170711_copy:12:f30'})
SET f.text = 'leading to a stationary series combination. Hence xt and yt are cointegrated when a = 2 and', f.meaning = '', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';

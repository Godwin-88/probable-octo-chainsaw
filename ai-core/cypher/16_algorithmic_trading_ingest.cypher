SET f.text = 'Our ﬁrst task is to deﬁne a random walk zt = zt−1 +wt, where wt is discrete white noise. With', f.meaning = '', f.sourceId = 'aat-ebook-20170711_copy', f.sectionId = 'aat-ebook-20170711_copy:12';
